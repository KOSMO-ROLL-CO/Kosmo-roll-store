{
  "name": "kosmo-roll-site",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test e2e/checkout-flow.spec.ts e2e/exploratory.spec.ts e2e/navigation-responsive.spec.ts e2e/product-images.spec.ts e2e/visual-regression.spec.ts",
    "test:security": "vitest run src/tests/security",
    "test:exploratory": "playwright test e2e/exploratory.spec.ts",
    "test:a11y": "playwright test e2e/accessibility.spec.ts --project=chromium",
    "test:visual": "playwright test e2e/visual-regression.spec.ts",
    "test:perf": "playwright test e2e/performance-web-vitals.spec.ts --project=chromium",
    "test:stress": "playwright test e2e/stress-memory.spec.ts --project=chromium",
    "test:images": "playwright test e2e/product-images.spec.ts"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "framer-motion": "^12.43.0",
    "lucide-react": "^1.28.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/coverage-v8": "^4.1.10",
    "jsdom": "^29.1.1",
    "msw": "^2.15.0",
    "oxlint": "^1.75.0",
    "sharp": "^0.35.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
